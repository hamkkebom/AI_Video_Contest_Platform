# ============================================================
# 함께봄 AI 영상 공모전 — 환경 변수 템플릿
# .env.local에 복사 후 실제 값을 입력하세요
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Cloudflare Stream ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token

# --- 사이트 URL (배포 환경) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key

# --- Sentry (에러 모니터링) ---
# 아래 값들은 모두 선택 사항입니다. 미설정 시 Sentry 초기화를 건너뛰며
# 빌드·런타임 모두 정상 동작합니다(no-op).
#
# DSN: Sentry 프로젝트 생성 후 Settings > Client Keys (DSN)에서 발급
NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@o0000000.ingest.sentry.io/0000000
#
# 소스맵 업로드용 토큰 — 설정 시에만 소스맵이 업로드됩니다.
# Sentry > Settings > Auth Tokens에서 발급 (project:releases 권한 필요)
SENTRY_AUTH_TOKEN=sntrys_your-sentry-auth-token
#
# 소스맵 업로드 대상 조직/프로젝트 슬러그 (SENTRY_AUTH_TOKEN과 함께 사용)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# --- 이메일 발송 (Resend) ---
# 미설정 시 발송을 조용히 건너뛰고, 관리자 화면이 "메일이 나가지 않았다"고 알립니다.
# 회원 통지는 사이트 안 문의함으로 처리하므로(D-017) 메일은 **계정이 없는 상대**에게만 씁니다.
#
# aikkumhub.com 의 DKIM/SPF/MX 는 이미 등록돼 있습니다 (가비아 DNS 확인, 2026-08-02).
# 남은 것은 Resend 대시보드에서 API 키를 발급해 아래에 넣는 것뿐입니다.
RESEND_API_KEY=re_your-resend-api-key
#
# 보내는 사람 — 반드시 Resend 에서 인증된 도메인이어야 합니다 (기본값: AI꿈 <noreply@aikkumhub.com>)
EMAIL_FROM=AI꿈 <noreply@aikkumhub.com>
#
# 회신 받을 주소 (선택) — 문의자가 답변 메일에 회신하면 여기로 옵니다
EMAIL_REPLY_TO=
